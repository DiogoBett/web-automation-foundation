audit=true # [Enable / Disable] Automatic Vulnerability Scanning of your dependencies
audit-level=high # [Set] Severity Level for Audit Error
package-lock=true # [Enable / Disable] Package Lock File Generation
package-lock-only=false # [Enable / Disable] Package Lock Update
prefer-offline=true # [Enable / Disable] Use Cached Packages
save-exact=true # [Enable / Disable] Use Exact Versions