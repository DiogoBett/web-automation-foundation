{
  "name": "web-automation-foundation",
  "version": "2.0.0",
  "description": "Web Automation | Foundation",
  "type": "module",
  "main": "cypress.config.js",
  "scripts": {
    "cy:open:dev": "cypress open --e2e --browser chrome --expose environment=dev",
    "cy:open:preprod": "cypress open --e2e --browser chrome --expose environment=preprod",
    "cy:open:prod": "cypress open --e2e --browser chrome --expose environment=prod",
    "cy:run:dev": "cypress run --browser chrome --expose environment=dev",
    "cy:run:preprod": "cypress run --browser chrome --expose environment=preprod",
    "cy:run:prod": "cypress run --browser chrome --expose environment=prod"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/*.{js,ts}"
    ],
    "html": {
      "enabled": true
    },
    "filterSpecs": true,
    "omitFiltered": true
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@faker-js/faker": "10.6.0",
    "@types/node": "24.19.2",
    "cypress": "16.3.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiogoBett/web-automation-foundation.git"
  },
  "author": "Diogo Bettencourt",
  "license": "MIT"
}
